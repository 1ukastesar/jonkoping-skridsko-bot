# Copy to .env and fill in. Only SKRIDSKO_WEBHOOK_URL is required.

# Discord channel webhook: Edit Channel > Integrations > Webhooks > New Webhook > Copy URL
SKRIDSKO_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/xxxxxxxxxxxxxxxxxxxx

# Page to scrape (change only if the municipality moves it)
SKRIDSKO_URL=https://www.jonkoping.se/fritid-kultur--natur/idrott-motion-och-bad/skridskoakning-allmanhetens-akning

# Local time of the daily post, and the timezone it is interpreted in
SKRIDSKO_POST_AT=07:00
SKRIDSKO_TZ=Europe/Stockholm

# 0 = today only. 1 also includes tomorrow, and so on.
SKRIDSKO_LOOKAHEAD_DAYS=0

# Optional: only report these rinks (comma-separated substring match, case-insensitive)
# SKRIDSKO_RINKS=Rosenlundshallen,Råslätt

# Optional: prefix the post with a mention, e.g. <@&123456789012345678> or @here
# SKRIDSKO_MENTION=

# Post a "nothing today" message as well (true), or stay silent on empty days (false)
SKRIDSKO_POST_WHEN_EMPTY=true

# Where the last-good HTML copy and the healthcheck stamp are kept
SKRIDSKO_CACHE_DIR=/var/cache/skridsko-bot

SKRIDSKO_LOG_LEVEL=INFO
SKRIDSKO_HTTP_TIMEOUT=20
SKRIDSKO_HTTP_RETRIES=3
# SKRIDSKO_USER_AGENT=jonkoping-skridsko-bot/1.0 (contact: you@example.com)
